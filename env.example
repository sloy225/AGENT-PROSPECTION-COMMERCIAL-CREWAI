# =============================================================================
# .env.example — Template des variables d'environnement
# =============================================================================
# Copie ce fichier en ".env" et remplis les valeurs.
# Le fichier ".env" ne doit JAMAIS être commité sur GitHub (voir .gitignore).
# =============================================================================

# --- LLM Cloud (optionnel — uniquement si tu passes à GPT ou Claude) ---
OPENAI_API_KEY= met ta clé ici
ANTHROPIC_API_KEY= pareil ici

# --- Configuration Ollama (LLM local, utilisé par défaut dans ce POC) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/deepseek-r1:1.5b
